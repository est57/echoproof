{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.est57/echoproof",
  "title": "Echoproof",
  "description": "Replay real HTTP traffic against base and changed builds; flag behavior changes the intent omits.",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/est57/echoproof",
    "source": "github"
  },
  "websiteUrl": "https://github.com/est57/echoproof",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "echoproof",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "ANTHROPIC_API_KEY",
          "description": "Used only when a check is given an intent to judge.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
